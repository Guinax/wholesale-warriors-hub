{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://knoypszawytcyjcuheor.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "familia-maromba-mcp",
      "version": "0.1.0",
      "title": "Loja Oficial Família Maromba"
    },
    "tools": [
      {
        "name": "list_products",
        "title": "Listar produtos",
        "description": "Lista os produtos ativos do catálogo da Loja Família Maromba, opcionalmente filtrados por categoria (suplementos, roupas, acessorios, equipamento, cimed, mansao).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "Categoria opcional (ex: suplementos, roupas, acessorios, equipamento)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Quantidade máxima de itens (padrão 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_order",
        "title": "Consultar pedido",
        "description": "Consulta os detalhes e o status de um pedido pelo seu código (ex: FM-XXXXXX).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "order_code": {
              "type": "string",
              "minLength": 3,
              "description": "Código do pedido, como aparece no recibo."
            }
          },
          "required": [
            "order_code"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_orders",
        "title": "Meus pedidos",
        "description": "Lista os pedidos feitos pelo e-mail do usuário autenticado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Quantidade máxima (padrão 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
